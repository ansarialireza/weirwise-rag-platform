# Weirwise Platform Environment Configuration Template
# Copy this file to .env before starting services. Never commit .env to version control.

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-32-byte-base64-string
API_KEY_SALT=replace-with-a-secure-salt-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Platform PostgreSQL)
POSTGRES_USER=weirwise_platform
POSTGRES_PASSWORD=weirwise_platform_pass
POSTGRES_DB=weirwise_platform_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://weirwise_platform:weirwise_platform_pass@localhost:5433/weirwise_platform_db

# Redis & Background Queue (Celery / ARQ / Redis Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
STORAGE_BACKEND=local
# Options: 'local' (development), 's3' (production/staging)
STORAGE_LOCAL_DIR=/tmp/weirwise_uploads
STORAGE_COLD_DIR=/mnt/gdrive/weirwise/storage/documents
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=weirwise-platform-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Weirwise Core Integration Boundary
# Platform calls Core via authenticated HTTP REST API
WEIRWISE_CORE_BASE_URL=http://localhost:8001
WEIRWISE_CORE_API_KEY=ww_example_tenant_api_key_replace_me

# Shopify OAuth (optional; credentials must remain server-side)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/integrations/shopify/oauth/callback
SHOPIFY_FRONTEND_RETURN_URL=http://localhost:3000/settings
SHOPIFY_SCOPES=read_products
SHOPIFY_OAUTH_STATE_TTL_SECONDS=600
SHOPIFY_API_VERSION=2026-10
SHOPIFY_MAX_PRODUCTS=10000

# Google Drive OAuth (optional; credentials must remain server-side)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_FRONTEND_RETURN_URL=http://localhost:3000/sources
GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email"
GOOGLE_DRIVE_OAUTH_STATE_TTL_SECONDS=600

# Google Drive OAuth (credentials remain server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/oauth/callback
GOOGLE_FRONTEND_RETURN_URL=http://localhost:3000/sources
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_DRIVE_MAX_FILES=500

# Simulated integration journeys — local/test use only; production rejects enabled demos
DEMO_INTEGRATIONS_ENABLED=false
DEMO_INTEGRATIONS_FRONTEND_URL=http://localhost:3000
DEMO_INTEGRATION_STATE_TTL_SECONDS=300

# CORS & Frontend
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# RAG & Embedding Engine Default
DEFAULT_EMBEDDING_MODEL=jina-embeddings-v4
DEV_CORE_EMBEDDING_BASE_URL=https://api.jina.ai/v1
DEV_CORE_EMBEDDING_API_KEY=your_jina_api_key_here
DEV_CORE_EMBEDDING_MODEL=jina-embeddings-v4
DEV_CORE_EMBEDDING_DIMENSIONS=1536
PROD_CORE_EMBEDDING_BASE_URL=https://api.jina.ai/v1
PROD_CORE_EMBEDDING_API_KEY=your_jina_api_key_here
PROD_CORE_EMBEDDING_MODEL=jina-embeddings-v4
PROD_CORE_EMBEDDING_DIMENSIONS=1536

# Email / SMTP / Resend Configuration
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@weirwise.com
SMTP_FROM_NAME="Weirwise Platform"
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=15

# Voice (Deepgram) — server-side only; audio and replies are relayed by the API
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-asteria-en
